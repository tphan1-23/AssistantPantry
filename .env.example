EXPO_PUBLIC_GEMINI_API_KEY=your_actual_gemini_api_key_here

# Optional: override the default model (gemini-flash-latest) if it's
# temporarily overloaded (503 "high demand" errors).
# EXPO_PUBLIC_GEMINI_MODEL=gemini-flash-lite-latest

# From your Supabase project's dashboard: Project Settings -> API.
# Use the bare project URL (no /rest/v1/ or other path suffix - the client
# appends the right path per service itself).
# Also run supabase/schema.sql once in that project's SQL Editor before
# signing up, so the pantry_items/favorite_recipes tables and the avatars
# storage bucket exist.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
