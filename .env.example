# From your Supabase project's dashboard: Project Settings -> API.
# Use the bare project URL (no /rest/v1/ or other path suffix - the client
# appends the right path per service itself).
# Also run supabase/schema.sql once in that project's SQL Editor before
# signing up, so the pantry_items/favorite_recipes tables and the avatars
# storage bucket exist.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# The Gemini API key is NOT a client env var any more - it's never shipped
# inside the app bundle. Instead, deploy supabase/functions/gemini-proxy and
# set it as a server-side secret on your Supabase project:
#   supabase functions deploy gemini-proxy
#   supabase secrets set GEMINI_API_KEY=your_actual_gemini_api_key_here
#   supabase secrets set GEMINI_MODEL=gemini-flash-lite-latest   (optional override)
